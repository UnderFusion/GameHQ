{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gamehq.local/schema/locale-style.schema.json",
  "title": "GameHQ locale translation style",
  "type": "object",
  "required": ["$schema", "schema_version", "locale", "source_language", "tone", "capitalization", "button_labels", "technical_terms", "punctuation", "units", "natural_language"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "source_language": { "const": "en-US" },
    "tone": { "type": "string", "minLength": 1 },
    "capitalization": { "type": "string", "minLength": 1 },
    "button_labels": { "type": "string", "minLength": 1 },
    "technical_terms": { "type": "string", "minLength": 1 },
    "punctuation": { "type": "string", "minLength": 1 },
    "units": { "type": "string", "minLength": 1 },
    "natural_language": { "type": "string", "minLength": 1 }
  }
}
