{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamehq.app/schemas/release-notes-manifest.schema.json",
  "title": "GameHQ release-note source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_locale", "history_limit", "production_locales", "releases"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "source_locale": { "const": "en-US" },
    "history_limit": { "const": 12 },
    "production_locales": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "date", "status", "localization_policy", "source_integrity", "original_source_integrity", "correction"],
        "properties": {
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "date": { "type": "string", "format": "date" },
          "status": { "const": "released" },
          "localization_policy": { "enum": ["fallback-allowed", "complete"] },
          "source_integrity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "original_source_integrity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "correction": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["reason", "approved_by", "corrected_at"],
                "properties": {
                  "reason": { "type": "string", "minLength": 1 },
                  "approved_by": { "type": "string", "minLength": 1 },
                  "corrected_at": { "type": "string", "format": "date" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
