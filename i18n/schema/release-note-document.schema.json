{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamehq.app/schemas/release-note-document.schema.json",
  "title": "GameHQ versioned release-note document",
  "oneOf": [
    { "$ref": "#/$defs/english" },
    { "$ref": "#/$defs/localized" },
    { "$ref": "#/$defs/fallback" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["schema_version", "version", "locale", "date"],
      "properties": {
        "$schema": { "type": "string" },
        "schema_version": { "const": 2 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "locale": { "type": "string" },
        "date": { "type": "string", "format": "date" }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "items"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "text": { "type": "string", "minLength": 1, "maxLength": 1200 }
              }
            }
          }
        }
      }
    },
    "english": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "additionalProperties": false,
          "required": ["$schema", "schema_version", "version", "locale", "date", "sections"],
          "properties": {
            "$schema": true,
            "schema_version": true,
            "version": true,
            "locale": { "const": "en-US" },
            "date": true,
            "sections": { "$ref": "#/$defs/sections" }
          }
        }
      ]
    },
    "localized": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "additionalProperties": false,
          "required": ["$schema", "schema_version", "version", "locale", "date", "mode", "source_integrity", "sections"],
          "properties": {
            "$schema": true,
            "schema_version": true,
            "version": true,
            "locale": { "not": { "const": "en-US" } },
            "date": true,
            "mode": { "const": "localized" },
            "source_integrity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "sections": { "$ref": "#/$defs/sections" }
          }
        }
      ]
    },
    "fallback": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "additionalProperties": false,
          "required": ["$schema", "schema_version", "version", "locale", "date", "mode", "source_integrity", "fallback_locale"],
          "properties": {
            "$schema": true,
            "schema_version": true,
            "version": true,
            "locale": { "not": { "const": "en-US" } },
            "date": true,
            "mode": { "const": "fallback" },
            "source_integrity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "fallback_locale": { "const": "en-US" }
          }
        }
      ]
    }
  }
}
