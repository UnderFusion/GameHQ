{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gamehq.local/schema/translation-response.schema.json",
  "title": "GameHQ bounded translation response",
  "type": "object",
  "required": ["$schema", "protocol_version", "batch_id", "source_locale", "target_locale", "units"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "protocol_version": { "const": 1 },
    "batch_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "source_locale": { "const": "en-US" },
    "target_locale": { "type": "string", "minLength": 2 },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/unit" }
    }
  },
  "definitions": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "unit": {
      "type": "object",
      "required": ["id", "source_hash", "translation", "translation_hash", "status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^gamehq(\\.[a-z0-9][a-z0-9_-]*)+$" },
        "source_hash": { "$ref": "#/definitions/hash" },
        "translation": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "translation_hash": { "$ref": "#/definitions/hash" },
        "status": { "const": "machine_translated" },
        "provenance": {
          "type": "object",
          "required": ["kind", "actor"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "machine" },
            "actor": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
