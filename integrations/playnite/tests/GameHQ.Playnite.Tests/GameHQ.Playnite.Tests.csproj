<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GameHQ.Playnite.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <!-- The linked locator is intentionally Windows-only; tests exercise its
         pure candidate/precedence seam on any host without opening HKCU. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Only needed to compile GameHQLocator.cs here; the plugin itself
         needs no NuGet reference for it (built into .NET Framework). -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test the real protocol/locator source directly rather than a copy,
         so these tests fail the moment the shared logic regresses. Neither
         file depends on Playnite.SDK or System.Web.Extensions. -->
    <Compile Include="..\..\src\GameHQ.Playnite\Protocol\PipeFraming.cs" Link="Sources\PipeFraming.cs" />
    <Compile Include="..\..\src\GameHQ.Playnite\GameHQLocator.cs" Link="Sources\GameHQLocator.cs" />
    <Compile Include="..\..\src\GameHQ.Playnite\Security\ReleaseTrust.cs" Link="Sources\ReleaseTrust.cs" />
    <Compile Include="..\..\src\GameHQ.Playnite\Localization\PluginLocalization.cs" Link="Sources\PluginLocalization.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\tests\fixtures\release-trust\gamehq-test-vector.json"
          Link="Fixtures\gamehq-test-vector.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\GameHQ.Playnite\Localization\*.xaml"
          Link="Localization\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\GameHQ.Playnite\Localization\locale-map.json"
          Link="Localization\locale-map.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\i18n\locales.json"
          Link="Registry\gamehq-locales.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\GameHQ.Playnite\Settings\GameHQIntegrationSettingsView.xaml"
          Link="Audit\GameHQIntegrationSettingsView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\GameHQ.Playnite\Settings\GameHQIntegrationSettingsViewModel.cs"
          Link="Audit\GameHQIntegrationSettingsViewModel.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\GameHQ.Playnite\GameHQPlugin.cs"
          Link="Audit\GameHQPlugin.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\GameHQ.Playnite\GameHQ.Playnite.csproj"
          Link="Audit\GameHQ.Playnite.csproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\GameHQ.Playnite\extension.yaml"
          Link="Audit\extension.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\AddonManifest.yaml"
          Link="Audit\AddonManifest.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\InstallerManifest.yaml"
          Link="Audit\InstallerManifest.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\README.md"
          Link="Audit\README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\packaging\package.ps1"
          Link="Audit\package.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
