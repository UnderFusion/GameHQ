  <sys:String x:Key="LOCGameHQIntegrationDiagnosticsProtocolFormat">Протокол: {0}</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationDiagnosticsConnectionStateFormat">Стан підключення: {0}</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationStateConnected">Підключено</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationStateConnecting">Підключення...</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationStateWaitingForUpdate">Очікування (GameHQ оновлюється)</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationStateDisconnected">Не підключено</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationInvalidSelectedPath">Вибраний шлях не містить встановленої копії GameHQ.</sys:String>
