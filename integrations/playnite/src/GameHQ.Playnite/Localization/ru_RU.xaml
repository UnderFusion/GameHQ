  <sys:String x:Key="LOCGameHQIntegrationStatus">Состояние</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationGameHQVersion">Версия GameHQ</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationPluginVersion">Версия дополнения</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationProtocol">Протокол</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationTestConnection">Проверить подключение</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationSectionStartup">Запуск</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationStartWithPlaynite">Запускать GameHQ вместе с Playnite</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationStartOnGameLaunch">Запускать GameHQ при запуске игры, если приложение ещё не работает</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationSectionSupport">Поддержка</sys:String>
