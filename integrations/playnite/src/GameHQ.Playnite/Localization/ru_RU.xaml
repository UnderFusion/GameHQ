<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <sys:String x:Key="LOCGameHQIntegrationName">Интеграция GameHQ</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationSubtitle">Дополнение GameHQ для Playnite</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationSectionConnection">Подключение</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationConnectionDescription">Сообщает отдельному приложению GameHQ, какая игра запущена. GameHQ устанавливается отдельно — это дополнение не скачивает и не устанавливает его.</sys:String>
  <sys:String x:Key="LOCGameHQIntegrationGameHQLocation">Расположение GameHQ</sys:String>
