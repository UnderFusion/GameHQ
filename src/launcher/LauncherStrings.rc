#pragma code_page(65001)

#include <windows.h>
#include "LauncherResources.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    IDS_LAUNCHER_TITLE "GameHQ"
    IDS_LAUNCHER_PATH_TOO_DEEP "GameHQ is installed too deep for Windows to start it.\nMove the GameHQ folder somewhere with a shorter path."
    IDS_LAUNCHER_UPDATE_ACTIVE "GameHQ is being updated. Please try again shortly."
    IDS_LAUNCHER_EXE_MISSING "app\\GameHQ.exe not found next to the launcher."
    IDS_LAUNCHER_COMMAND_TOO_LONG "The command line passed to GameHQ is too long for Windows."
    IDS_LAUNCHER_START_FAILED "Failed to start app\\GameHQ.exe."
    IDS_LAUNCHER_ENGLISH_FALLBACK_PROBE "English fallback probe"
END

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
STRINGTABLE
BEGIN
    IDS_LAUNCHER_TITLE "GameHQ"
    IDS_LAUNCHER_PATH_TOO_DEEP "GameHQ 的安装路径过深，Windows 无法启动它。\n请将 GameHQ 文件夹移到路径较短的位置。"
    IDS_LAUNCHER_UPDATE_ACTIVE "GameHQ 正在更新，请稍后再试。"
    IDS_LAUNCHER_EXE_MISSING "在启动器旁未找到 app\\GameHQ.exe。"
    IDS_LAUNCHER_COMMAND_TOO_LONG "传递给 GameHQ 的命令行对 Windows 来说过长。"
    IDS_LAUNCHER_START_FAILED "无法启动 app\\GameHQ.exe。"
END

