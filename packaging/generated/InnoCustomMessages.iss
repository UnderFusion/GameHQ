[CustomMessages]
; locale=en-US; fallback=none
GameHQWelcomeTitle=Welcome to GameHQ
GameHQWelcomeBody=Setup will install [name/ver] on this computer.%n%nClose GameHQ before continuing.
GameHQDesktopShortcut=Create a desktop shortcut
GameHQAdditionalShortcuts=Additional shortcuts:
GameHQLaunch=Launch GameHQ
GameHQStageDetail= (stage: %1)
GameHQUpdateActive=A GameHQ update is running%1. Let it finish, then try again.
GameHQUpdateStale=A previous GameHQ update did not finish%1. Start GameHQ once so it can recover, then try again.
GameHQNothingRemoved=Nothing has been removed - your installation is still there.
GameHQSetupAppRunning=GameHQ is running. Close it normally - including in any other Windows session - then run Setup again.
GameHQUninstallAppRunning=GameHQ is running. Close it normally - including in any other Windows session - before uninstalling.

; locale=zh-Hans; fallback=en-US
chinesesimp.GameHQWelcomeTitle=欢迎使用 GameHQ
chinesesimp.GameHQWelcomeBody=安装程序将在此计算机上安装 [name/ver]。%n%n继续前请关闭 GameHQ。
