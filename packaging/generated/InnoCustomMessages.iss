; locale=pl-PL; fallback=en-US
polish.GameHQWelcomeTitle=Witamy w GameHQ
polish.GameHQWelcomeBody=Instalator zainstaluje [name/ver] na tym komputerze.%n%nPrzed kontynuowaniem zamknij GameHQ.
polish.GameHQDesktopShortcut=Utwórz skrót na pulpicie
polish.GameHQAdditionalShortcuts=Dodatkowe skróty:
